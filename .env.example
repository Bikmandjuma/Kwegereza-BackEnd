DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="https://kwegereza.org"
NODE_ENV="development"
VAPID_PUBLIC_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"
GOOGLE_CLIENT_ID="REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID"
GMAIL_USER="REPLACE_WITH_YOUR_GMAIL_ADDRESS"
GMAIL_APP_PASSWORD="REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"

# ---- mediasoup (live-class audio/video SFU) ----
# REQUIRED in production: this server's public IP address. Without it,
# mediasoup announces a private/local address to remote peers and only
# same-network participants can connect (this was the bug in the old
# standalone demo, which hardcoded 192.168.x.x).
MEDIASOUP_ANNOUNCED_IP="REPLACE_WITH_THIS_SERVER_PUBLIC_IP"
MEDIASOUP_LISTEN_IP="0.0.0.0"
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
# Open MEDIASOUP_MIN_PORT-MEDIASOUP_MAX_PORT for BOTH udp and tcp in your
# firewall/security group, in addition to the usual PORT above.
# MEDIASOUP_NUM_WORKERS=4   # optional; defaults to (CPU cores - 1)
