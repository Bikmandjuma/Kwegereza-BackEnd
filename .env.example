DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# Shared secret for the LiveClass service's server-to-server calls (see
# src/routes/internalRoutes.ts) -- MUST match INTERNAL_API_SECRET in that
# service's own .env exactly, and must never be exposed to any frontend.
INTERNAL_API_SECRET="change-this-to-a-different-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
VAPID_PUBLIC_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"
GOOGLE_CLIENT_ID="REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID"
GMAIL_USER="REPLACE_WITH_YOUR_GMAIL_ADDRESS"
GMAIL_APP_PASSWORD="REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"

# Live class (mediasoup) is its own separate service now -- see
# ../Kwegereza-LiveClass/.env.example. This API has no mediasoup
# dependency and needs none of its env vars.

# Live class recording downloads: this server generates presigned GET
# URLs against this same bucket (see recordingController.ts). Must be
# the SAME bucket/credentials as Kwegereza-LiveClass's EGRESS_S3_* --
# that service is what uploads the file, this one is what lets a host
# download it. Any S3-compatible store works (AWS S3, Cloudflare R2,
# DigitalOcean Spaces, or a free self-hosted MinIO instance).
EGRESS_S3_ACCESS_KEY=""
EGRESS_S3_SECRET=""
EGRESS_S3_BUCKET=""
EGRESS_S3_REGION="auto"
EGRESS_S3_ENDPOINT=""
